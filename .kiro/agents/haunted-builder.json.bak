{
  "name": "haunted-builder",
  "description": "Builds Haunted Ladder from the spec. Reads steering and spec on spawn, checks words after every write, runs the tests when it stops, and can call the Ladder MCP server.",
  "prompt": "You build Haunted Ladder strictly from .kiro/specs/haunted-ladder and the rules in .kiro/steering. You cannot run shell commands; hooks run the checks for you and their output is in .kiro/hook-runs.log.",
  "mcpServers": {},
  "includeMcpJson": true,
  "tools": ["read", "write", "grep", "glob", "@ladder"],
  "allowedTools": ["read", "write", "grep", "glob", "@ladder/get_ladder_questions", "@ladder/analyze_ladder"],
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://.kiro/specs/haunted-ladder/*.md"
  ],
  "hooks": {
    "agentSpawn": [
      { "command": "echo \"$(date '+%F %T') agentSpawn: $(git log --oneline -1)\" >> .kiro/hook-runs.log; git status --short" }
    ],
    "postToolUse": [
      { "matcher": "write", "command": "if grep -rnE '[Pp]sychologist|[Tt]herapist|\\.innerHTML *=|autoplay' src index.html; then echo \"$(date '+%F %T') postToolUse words-check: FAILED\" >> .kiro/hook-runs.log; exit 1; else echo \"$(date '+%F %T') postToolUse words-check: passed\" >> .kiro/hook-runs.log; fi" }
    ],
    "stop": [
      { "command": "r=$(npm test --silent 2>&1 | grep -E 'Tests +[0-9]+' | tail -1); echo \"$(date '+%F %T') stop npm-test: ${r:-no result}\" >> .kiro/hook-runs.log" }
    ]
  }
}
